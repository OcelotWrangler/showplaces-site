# Copy to .env.local for local development. Amplify holds the real values as
# environment variables on the app.

# --- MapKit JS -------------------------------------------------------------
# A Maps token from the Apple Developer account:
#   Certificates, Identifiers & Profiles -> Services -> Maps -> Configure
#   -> Tokens -> + -> Token Type "MapKit JS"
#
# Production uses Restriction Type = Domain with Websites set to
# "showplaces.app,www.showplaces.app". That token is REJECTED on localhost, so
# for local development create a second token with Restriction Type = None.
#
# This is public by design — MapKit JS needs it in the browser, and the domain
# restriction is what protects it. Revoke it in the portal if it ever leaks.
# Leave blank to develop without a map; the pages still render.
NEXT_PUBLIC_MAPKIT_TOKEN=

# --- Pharos (backend) ------------------------------------------------------
# Defaults to https://api.showplaces.app. Point at a local Vapor instance to
# develop the invite pages against local data.
# API_BASE_URL=http://localhost:8080
